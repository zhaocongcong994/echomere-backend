# Copy this file to deploy/production/.env.production and replace every value.
# Never commit the copied file.

AGENT_SHARED_SECRET=replace-with-at-least-32-random-characters
AGENT_METRICS_TOKEN=replace-with-at-least-32-random-characters
BACKEND_METRICS_TOKEN=replace-with-at-least-32-random-characters
JWT_SECRET=replace-with-at-least-32-random-characters

# Rotate the key previously used during development before deployment.
LLM_API_KEY=replace-with-a-new-rotated-provider-key
LLM_BASE_URL=https://api.deepseek.com
LLM_ACTIVE_PROFILE=deepseek-flash

# Exact, comma-separated login emails allowed to switch models.
AGENT_RUNTIME_MODEL_ADMIN_EMAILS=admin@example.com
AGENT_RUNTIME_MODEL_CONTROL_ENABLED=true
AGENT_RUNTIME_MODEL_SWITCH_ENABLED=true

# Public frontend origin. Multiple origins are comma-separated; wildcards fail startup.
CORS_ORIGINS=https://app.example.com

# Bind to 127.0.0.1 when a same-host reverse proxy publishes the Backend.
# Use 0.0.0.0 only when the host firewall or deployment platform controls ingress.
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PUBLIC_PORT=3001
FRONT_BIND_ADDRESS=127.0.0.1
FRONT_PUBLIC_PORT=3101

AGENT_MAX_CONCURRENT_RUNS=8
AGENT_MAX_CONCURRENT_RUNS_PER_USER=2
AGENT_MAX_QUALITY_REWRITES=1
LOG_LEVEL=info
