# Local SQLite database. Relative paths are resolved from the repository root.
DATABASE_URL="file:./dev.db"

# Server settings
PORT=3001
CORS_ORIGINS="http://localhost:3000"
JWT_SECRET="replace-with-a-long-random-string"
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=15000
METRICS_TOKEN="replace-with-a-long-random-metrics-token"

# LLM credentials belong to the Agent service; Backend does not call a model.

# Agent service. Keep both services on a private network in production.
AGENT_SERVICE_URL="http://127.0.0.1:4310"
AGENT_CONNECT_TIMEOUT_MS=10000
AGENT_SHARED_SECRET="replace-with-the-same-secret-as-agent-service"
# The Agent must also enable runtime model switching. In production, this
# requires a comma-separated administrator allowlist.
AGENT_RUNTIME_MODEL_CONTROL_ENABLED=false
AGENT_RUNTIME_MODEL_ADMIN_EMAILS=

# Per-user chat protection. Use memory for one local process and Redis when
# running more than one Backend instance.
CHAT_RATE_LIMIT_MAX=20
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_STORE=memory
REDIS_URL="redis://127.0.0.1:6379"
CHAT_RATE_LIMIT_REDIS_PREFIX="echomere:chat-rate"
CHAT_RATE_LIMIT_REDIS_TIMEOUT_MS=2000
