# Local SQLite database. Relative paths are resolved from the repository root.
DATABASE_URL="file:./dev.db"

# Server settings
PORT=3001
CORS_ORIGINS="http://localhost:3000"
JWT_SECRET="replace-with-a-long-random-string"

# Optional: without an API key, chat returns a local placeholder response.
LLM_API_KEY=""
LLM_BASE_URL="https://api.moonshot.cn/v1"
LLM_MODEL="moonshot-v1-8k"
