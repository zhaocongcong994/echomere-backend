LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_MS=60000
LLM_MAX_TOKENS=2048
LLM_THINKING=disabled
# Only applies when LLM_THINKING=enabled.
LLM_REASONING_EFFORT=high
# Optional named model profiles. Copy config/model-profiles.example.json to a
# gitignored local file, then select one profile by id.
LLM_PROFILES_FILE=
LLM_ACTIVE_PROFILE=
AGENT_HOST=127.0.0.1
AGENT_PORT=4310
AGENT_DB_PATH=./data/agent.db
AGENT_SHARED_SECRET=
AGENT_METRICS_TOKEN=
AGENT_CONCURRENCY_STORE=memory
AGENT_MAX_CONCURRENT_RUNS=8
AGENT_MAX_CONCURRENT_RUNS_PER_USER=2
AGENT_MAX_MODEL_INPUT_CHARACTERS=32000
AGENT_MAX_PROVIDER_RETRIES=1
AGENT_MAX_QUALITY_REWRITES=1
AGENT_PROVIDER_RETRY_BASE_DELAY_MS=500
AGENT_PROVIDER_RETRY_MAX_DELAY_MS=4000
# Enables authenticated runtime profile switching. `local` is loopback-only.
# Production requires `service`, a strong shared secret, a profile file, a
# persistent absolute selection path, and the exact private-network confirmation.
AGENT_RUNTIME_MODEL_SWITCH_ENABLED=false
AGENT_RUNTIME_MODEL_SWITCH_MODE=local
AGENT_RUNTIME_MODEL_SWITCH_SERVICE_CONFIRM=
AGENT_RUNTIME_MODEL_SELECTION_PATH=./data/runtime-model-profile.json
AGENT_RUNTIME_MODEL_SWITCH_VALIDATION_TIMEOUT_MS=10000
AGENT_CONCURRENCY_LEASE_TTL_MS=180000
AGENT_CONCURRENCY_REDIS_PREFIX=echomere:agent-runs
AGENT_CONCURRENCY_REDIS_TIMEOUT_MS=2000
REDIS_URL=redis://127.0.0.1:6379
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=30000

# Agent 工具数据源：mock 或 echomere-backend
AGENT_TOOLS_PROVIDER=mock
ECHOMERE_BACKEND_URL=http://127.0.0.1:3001
ECHOMERE_BACKEND_TIMEOUT_MS=10000

# 仅供本地 CLI/单用户联调。HTTP 服务会优先透传请求的 Bearer Token。
ECHOMERE_BACKEND_TOKEN=

# Production uses absolute persistent paths, Redis, echomere-backend tools,
# strong secrets and `npm run server:production`. See deploy/production/.
